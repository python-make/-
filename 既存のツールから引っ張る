import maya.cmds as cmds

#コンテキストをグローバルで既存の頂点カラーペイントツールにする
global ctx_name
ctx_name = "artAttrColorPerVertexContext"

#----コールバック関数---------------------------------------#
#ボタンでツール起動、またはスタートアップ時、頂点ペイントツールが起動されていない時に出す警告
def if_not_paint_tool_startup(*_):
    sel = cmds.ls(selection=True)
    if not sel:
        cmds.warning("オブジェクトを選択した状態でないとペイントできません。")
    try:
        #現在アクティブなツールを調べる
        ctx = cmds.currentCtx()
        #もし現在アクティブなツールがペイントツールならすでにあると伝え、アクティブでなかったらそのツールを開く
        if ctx == ctx_name:
            cmds.inViewMessage(assistMessage="すでに頂点カラーペイントツールになっています。", pos="topCenter", fade=True)
        else:
            cmds.setToolTo(ctx_name)
            cmds.inViewMessage(assistMessage="頂点カラーペイントに切り替えました。", pos="topCenter", fade=True)
    #エラーが出たら？？？[要確認]
    except RuntimeError:
        cmds.warning("頂点カラーペイントツールを起動する必要があります。")
        cmds.confirmDialog(
                title="エラー",
                message="<b>頂点カラーペイントツールが起動されていません。</b><br>メッシュ表示>頂点カラーペイントツールを実行してください。",
                button=["OK"],
                defaultButton="OK",
                icon="warning"
            )

#色を設定する関数
def color_set_custom(rgb):
    cmds.artAttrPaintVertexCtx(ctx_name, edit=True, colorRGBValue=rgb)
        
#選択したコンポーネントのカラー削除関数
def sel_remove_color():
    sel = cmds.ls(selection=True,  flatten=True)
    #もし選択されていなかったら
    if not sel:
        cmds.inViewMessage(
                assistMessage="コンポーネントまたはオブジェクトが選択されていません。",
                pos="topCenter",
                fade=True
            )
    #選択、カラーもある状態だったら
    else:
        for c in sel:
            cmds.polyColorPerVertex(c, remove=True)

#選択したオブジェクトを登録する
def set_obj_base_data():
    global base_data
    base_data = {}
    sel = cmds.ls(selection=True, dag=True, shapes=True) or []
    sel_re = cmds.listRelatives(sel, parent=True) or []
    #最初に選択したオブジェクトを辞書に入れる
    if sel:
        base_data[sel_re[0]] = sel_re[0]
        cmds.textFieldButtonGrp("myTextButtonBase", edit=True, text=base_data[sel_re[0]])
        cmds.inViewMessage(assistMessage=f"{base_data[sel_re[0]]}をベースとして登録しました", pos="topCenter", fade=True)
        mesh = list(base_data.values())[0]
        #最初のオブジェクトの頂点をリストにする
        vtx_list = cmds.ls(mesh + ".vtx[*]", flatten=True)
        #ベースオブジェクトの頂点カラー情報を辞書に入れる
        vertex_color_data = {}
        for vtx in vtx_list:
            col = cmds.polyColorPerVertex(vtx, query=True, rgb=True)
            if col:
                vertex_color_data[vtx] = col
                print(vertex_color_data[vtx])
        return vertex_color_data
    else:
        if not sel:
            cmds.inViewMessage(assistMessage="オブジェクトが選択されていません。", pos="topCenter", fade=True)

row_items = []
column_list = None #ここに行を追加する

#選択したものを追加
def add_sel_obj(target_layout):
    sel = cmds.ls(selection=True)
    
    if not sel:
        cmds.warning("オブジェクトが選択されていません")
        return
    #すでにオブジェクトがある場合、警告
    for obj in sel:
        existing = [cmds.textField(n, query=True, text=True) for _, n, _ in row_items]
        if obj in existing:
            cmds.inViewMessage(assistMessage="すでにリストに登録されています。", pos="topCenter", fade=True)
            continue
        
        row = cmds.rowLayout(numberOfColumns=3,adjustableColumn=True, parent=target_layout)
        field_name = cmds.textField("colorOjbect", text=obj, editable=False, width=150)
        field_percent = cmds.floatField("colorPercent", value=0.0, minValue=0.0, maxValue=100.0, step=0.1, precision=1, width=60)
        remove_button = cmds.button(label="-", command=lambda _, r=row:sel_remove_button(r))
        cmds.setParent("..")
        row_items.append((row, field_name, remove_button))
        
def sel_remove_button(target_row):
    global row_items
    if cmds.layout(target_row, exists=True):
        cmds.deleteUI(target_row)
    row_items = [item for item in row_items if item[0] != target_row]


import maya.cmds as cmds



#選択したオブジェクトを登録する
def set_obj_base_data():
    global base_data
    base_data = {}
    sel = cmds.ls(selection=True, dag=True, shapes=True) or []
    sel_re = cmds.listRelatives(sel, parent=True) or []
    #最初に選択したオブジェクトを辞書に入れる
    if sel:
        base_data[sel_re[0]] = sel_re[0]
        cmds.textFieldButtonGrp("myTextButtonBase", edit=True, text=base_data[sel_re[0]])
        cmds.inViewMessage(assistMessage=f"{base_data[sel_re[0]]}をベースとして登録しました", pos="topCenter", fade=True)
    else:
        if not sel:
            cmds.inViewMessage(assistMessage="オブジェクトが選択されていません。", pos="topCenter", fade=True)
        
#basedataについているカラーの情報をリストとして出す     
def get_base_obj_Vertex_data():  
    mesh = list(base_data.values())[0]
    #最初のオブジェクトの頂点をリストにする
    vtx_list = cmds.ls(mesh + ".vtx[*]", flatten=True)
    #ベースオブジェクトの頂点カラー情報を辞書に入れる
    vertex_color_data = {}
    for vtx in vtx_list:
        col = cmds.polyColorPerVertex(vtx, query=True, rgb=True)
        if col:
            vertex_color_data[vtx] = col
    return vertex_color_data






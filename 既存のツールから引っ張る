import maya.cmds as cmds

#コンテキストをグローバルで既存の頂点カラーペイントツールにする
global ctx_name
ctx_name = "artAttrColorPerVertexContext"

#----コールバック関数---------------------------------------#
#ボタンでツール起動、またはスタートアップ時、頂点ペイントツールが起動されていない時に出す警告
def if_not_paint_tool_startup(*_):
    sel = cmds.ls(selection=True)
    if not sel:
        cmds.warning("オブジェクトを選択した状態でないとペイントできません。")
    try:
        #現在アクティブなツールを調べる
        ctx = cmds.currentCtx()
        #もし現在アクティブなツールがペイントツールならすでにあると伝え、アクティブでなかったらそのツールを開く
        if ctx == ctx_name:
            cmds.inViewMessage(assistMessage="すでに頂点カラーペイントツールになっています。", pos="topCenter", fade=True)
        else:
            cmds.setToolTo(ctx_name)
            cmds.inViewMessage(assistMessage="頂点カラーペイントに切り替えました。", pos="topCenter", fade=True)
    #エラーが出たら？？？[要確認]
    except RuntimeError:
        cmds.warning("頂点カラーペイントツールを起動する必要があります。")
        cmds.confirmDialog(
                title="エラー",
                message="<b>頂点カラーペイントツールが起動されていません。</b><br>メッシュ表示>頂点カラーペイントツールを実行してください。",
                button=["OK"],
                defaultButton="OK",
                icon="warning"
            )

#色を設定する関数
def color_set_custom(rgb):
    cmds.artAttrPaintVertexCtx(ctx_name, edit=True, colorRGBValue=rgb)
        
#選択したコンポーネントのカラー削除関数
def sel_remove_color():
    sel = cmds.ls(selection=True,  flatten=True)
    #もし選択されていなかったら
    if not sel:
        cmds.inViewMessage(
                assistMessage="コンポーネントまたはオブジェクトが選択されていません。",
                pos="topCenter",
                fade=True
            )
    #選択、カラーもある状態だったら
    else:
        for c in sel:
            cmds.polyColorPerVertex(c, remove=True)

#選択したオブジェクトを登録する
def set_obj_base_data():
    global base_data
    base_data = {}
    sel = cmds.ls(selection=True, dag=True, shapes=True) or []
    sel_re = cmds.listRelatives(sel, parent=True) or []
    #最初に選択したオブジェクトを辞書に入れる
    if sel:
        base_data[sel_re[0]] = sel_re[0]
        cmds.textFieldButtonGrp("myTextButtonBase", edit=True, text=base_data[sel_re[0]])
        cmds.inViewMessage(assistMessage=f"{base_data[sel_re[0]]}をベースとして登録しました", pos="topCenter", fade=True)
    else:
        if not sel:
            cmds.inViewMessage(assistMessage="オブジェクトが選択されていません。", pos="topCenter", fade=True)

